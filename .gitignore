
# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Variable files may contain environment-specific or sensitive values
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration and local credentials
.terraformrc
terraform.rc

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Environment variables
.env
.env.*
