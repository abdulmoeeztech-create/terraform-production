
# Retrieve the current Amazon Linux 2023 x86-64 AMI.
data "aws_ssm_parameter" "al2023_ami" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
}

variable "lab_vpc_id" {
  description = "VPC ID for the EC2 Secrets Manager lab"
  type        = string
}

variable "lab_subnet_id" {
  description = "Public subnet ID for the EC2 Secrets Manager lab"
  type        = string
}

# Dedicated EC2 role; keep the original app_reader role unchanged.
resource "aws_iam_role" "ec2_lab" {
  name = "terraform-production-dev-ec2-lab-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "ec2.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })

  tags = {
    Environment = var.environment
    Project     = var.project_name
    ManagedBy   = var.managed_by
    Purpose     = "LearningLab"
  }
}

# Allow the EC2 role to read only the designated lab secret.
resource "aws_iam_role_policy_attachment" "secret_reader_lab" {
  role       = aws_iam_role.ec2_lab.name
  policy_arn = aws_iam_policy.secret_reader.arn
}

# Enable Systems Manager Session Manager.
resource "aws_iam_role_policy_attachment" "ssm_core" {
  role       = aws_iam_role.ec2_lab.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

# Make the EC2 role available to the instance.
resource "aws_iam_instance_profile" "app_reader" {
  name = "terraform-production-dev-app-reader-profile"
  role = aws_iam_role.ec2_lab.name

  tags = {
    Environment = var.environment
    Project     = var.project_name
    ManagedBy   = var.managed_by
    Purpose     = "LearningLab"
  }
}

# No inbound access. Outbound HTTPS only.
resource "aws_security_group" "ec2_lab" {
  name        = "terraform-production-dev-ec2-lab-sg"
  description = "Outbound HTTPS only for the Secrets Manager lab"
  vpc_id      = var.lab_vpc_id

  # HTTPS access to AWS service APIs
  egress {
    description = "HTTPS for AWS service APIs"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # DNS queries within the VPC
  egress {
    description = "DNS queries"
    from_port   = 53
    to_port     = 53
    protocol    = "udp"
    cidr_blocks = ["172.31.0.0/16"]
  }


  tags = {
    Environment = var.environment
    Project     = var.project_name
    ManagedBy   = var.managed_by
    Purpose     = "LearningLab"
  }
}

resource "aws_instance" "secret_reader_lab" {
  ami                         = data.aws_ssm_parameter.al2023_ami.value
  instance_type               = "t3.micro"
  subnet_id                   = var.lab_subnet_id
  associate_public_ip_address = true

  vpc_security_group_ids = [
    aws_security_group.ec2_lab.id
  ]

  iam_instance_profile = aws_iam_instance_profile.app_reader.name

  metadata_options {
    http_endpoint = "enabled"
    http_tokens   = "required"
  }

  root_block_device {
    volume_size = 8
    volume_type = "gp3"
    encrypted   = true
  }
  depends_on = [
    aws_iam_role_policy_attachment.secret_reader_lab,
    aws_iam_role_policy_attachment.ssm_core
  ]
  tags = {
    Name        = "terraform-production-dev-secret-reader-lab"
    Environment = var.environment
    Project     = var.project_name
    ManagedBy   = var.managed_by
    Purpose     = "LearningLab"
  }
}
